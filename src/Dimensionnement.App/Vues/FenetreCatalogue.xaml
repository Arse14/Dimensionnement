<Window x:Class="Dimensionnement.App.Vues.FenetreCatalogue"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catalogues du matériel" Width="1440" Height="900" MinWidth="1000" MinHeight="600"
        Icon="/Ressources/icone.ico"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Fond}"
        Foreground="{StaticResource Texte}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- Onglets de la fiche : texte secondaire, soulignement orange sur l'onglet actif -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,12,0,0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Cadre" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="12,8" Background="Transparent">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Texte}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Texte}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#4A3A1A"/>
        </Style>

        <Style x:Key="Filtre" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Un champ de la fiche : libellé, valeur modifiable en mode édition, unité, « à compléter » et erreur de saisie -->
        <DataTemplate x:Key="ModeleChamp">
            <Border BorderBrush="{StaticResource PanneauClair}" BorderThickness="0,0,0,1" Padding="0,5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Width="200" Text="{Binding Libelle}" VerticalAlignment="Center"
                               Foreground="{StaticResource TexteSecondaire}" TextWrapping="Wrap"/>
                    <TextBlock DockPanel.Dock="Right" Width="44" Text="{Binding Unite}" VerticalAlignment="Center" Margin="6,0,0,0"
                               Foreground="{StaticResource TexteSecondaire}"/>
                    <StackPanel>
                        <TextBox x:Name="Saisie" Text="{Binding Valeur, UpdateSourceTrigger=LostFocus}"
                                 IsReadOnly="{Binding DataContext.Lecture, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <TextBlock Text="{Binding Erreur}" Foreground="#F85149" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding Erreur, Converter={StaticResource VideMasque}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DataContext.Lecture, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="Saisie" Property="Background" Value="Transparent"/>
                    <Setter TargetName="Saisie" Property="BorderBrush" Value="Transparent"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Manquant}" Value="True">
                    <Setter TargetName="Saisie" Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Saisie" Property="ToolTip" Value="À compléter : cliquez sur Modifier puis saisissez la valeur relevée sur la fiche du fabricant."/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Barre de filtres et d'actions -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panneau}" BorderBrush="{StaticResource Bordure}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Command="{Binding Nouveau}" ToolTip="Ajouter un article saisi à la main">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE710;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Nouvel article"/></StackPanel>
                    </Button>
                    <Button Command="{Binding Annuler}" Content="Annuler"/>
                    <Button Command="{Binding Enregistrer}" Style="{StaticResource BoutonAccent}">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE74E;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Enregistrer"/></StackPanel>
                    </Button>
                    <Menu Background="Transparent" VerticalAlignment="Center">
                        <MenuItem Header="&#xE712;" FontFamily="{StaticResource Icones}" Foreground="{StaticResource Texte}" Padding="8,4" ToolTip="Plus d'actions">
                            <MenuItem Header="Ouvrir le fichier brut (JSON)" Command="{Binding OuvrirFichier}" FontFamily="Segoe UI" Foreground="Black"/>
                            <MenuItem Header="Revenir au catalogue livré" Command="{Binding RevenirAuLivre}" FontFamily="Segoe UI" Foreground="Black"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
                <WrapPanel VerticalAlignment="Bottom">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource Filtre}" Text="CATALOGUE"/>
                        <ComboBox Width="220" ItemsSource="{Binding Familles}" SelectedItem="{Binding Famille}" DisplayMemberPath="Nom"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource Filtre}" Text="RECHERCHE"/>
                        <TextBox Width="240" Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 ToolTip="Référence, désignation, gamme ou toute valeur de l'article"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource Filtre}" Text="MARQUE"/>
                        <ComboBox Width="150" ItemsSource="{Binding Marques}" SelectedItem="{Binding Marque}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource Filtre}" Text="{Binding LibelleGamme, Converter={StaticResource Majuscules}}"/>
                        <ComboBox Width="190" ItemsSource="{Binding Gammes}" SelectedItem="{Binding Gamme}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0" Visibility="{Binding LibelleMinimum, Converter={StaticResource VideMasque}}">
                        <TextBlock Style="{StaticResource Filtre}" Text="{Binding LibelleMinimum}"/>
                        <TextBox Width="110" Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                    </StackPanel>
                    <CheckBox Content="Vérifiés seulement" IsChecked="{Binding VerifiesSeulement}" VerticalAlignment="Bottom" Margin="0,0,16,6"/>
                    <TextBlock Text="{Binding Compte}" Foreground="{StaticResource TexteSecondaire}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Bas : origine du catalogue -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panneau}" BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0" Padding="16,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Accent}" Text="Modifications non enregistrées"
                           Visibility="{Binding Modifie, Converter={StaticResource VraiVisible}}"/>
                <TextBlock Text="{Binding Origine}" Foreground="{StaticResource TexteSecondaire}" FontSize="12"/>
            </DockPanel>
        </Border>

        <Grid Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="560" MinWidth="440"/>
            </Grid.ColumnDefinitions>

            <!-- Tableau des articles ; colonnes propres à chaque catalogue, construites dans le code -->
            <DataGrid x:Name="Tableau" ItemsSource="{Binding Lignes}" SelectedItem="{Binding Selection}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="40"
                      Background="{StaticResource Panneau}" RowBackground="{StaticResource Panneau}" AlternatingRowBackground="{StaticResource PanneauClair}"
                      Foreground="{StaticResource Texte}" BorderBrush="{StaticResource Bordure}" HorizontalGridLinesBrush="{StaticResource Bordure}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource PanneauClair}"/>
                        <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}"/>
                        <Setter Property="Padding" Value="6,6"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource Selection}"/>
                                <Setter Property="Foreground" Value="{StaticResource Texte}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="48">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="34" Height="34" Background="{StaticResource Champ}" CornerRadius="3">
                                    <Grid>
                                        <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE7B8;" Foreground="{StaticResource Bordure}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Vignette, Converter={StaticResource CheminImage}, ConverterParameter=80}" Stretch="Uniform"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="170" FontFamily="Consolas"/>
                    <DataGridTextColumn Header="Marque" Binding="{Binding Marque}" Width="110"/>
                    <DataGridTemplateColumn Header="Statut" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="Pastille" Style="{StaticResource Badge}">
                                    <TextBlock x:Name="Libelle" Text="{Binding Statut}" FontSize="11" Foreground="#F5C069"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Verifie}" Value="True">
                                        <Setter TargetName="Pastille" Property="Background" Value="#1E3A2A"/>
                                        <Setter TargetName="Libelle" Property="Foreground" Value="#6EE7A0"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Fiche technique de l'article sélectionné -->
            <Border Grid.Column="2" Style="{StaticResource CadrePanneau}" Padding="18,16">
                <Grid>
                    <TextBlock Text="Aucun article : changez les filtres ou ajoutez un article avec « Nouvel article »." TextWrapping="Wrap"
                               Foreground="{StaticResource TexteSecondaire}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Visibility="{Binding AArticle, Converter={StaticResource FauxVisible}}"/>
                    <DockPanel Visibility="{Binding AArticle, Converter={StaticResource VraiVisible}}">
                        <!-- En-tête : photo, titre, référence, statut et actions -->
                        <DockPanel DockPanel.Dock="Top">
                            <Border DockPanel.Dock="Left" Width="96" Height="96" Background="{StaticResource Champ}" CornerRadius="6" Margin="0,0,14,0">
                                <Grid>
                                    <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE7B8;" FontSize="30" Foreground="{StaticResource Bordure}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding PhotoCourante, Converter={StaticResource CheminImage}, ConverterParameter=200}" Stretch="Uniform" Margin="4"/>
                                </Grid>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding SousTitre}" Foreground="{StaticResource TexteSecondaire}" FontSize="12"/>
                                <TextBlock Text="{Binding Titre}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Reference}" FontFamily="Consolas" FontSize="15" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                    <Border x:Name="BadgeFiche" Style="{StaticResource Badge}" Margin="10,0,0,0">
                                        <Border.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#F5C069"/>
                                                <Setter Property="Text" Value="indicatif"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Verifie}" Value="True">
                                                        <Setter Property="Foreground" Value="#6EE7A0"/>
                                                        <Setter Property="Text" Value="vérifié"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Resources>
                                        <TextBlock FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <WrapPanel.Resources>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Margin" Value="0,0,8,6"/>
                                        </Style>
                                    </WrapPanel.Resources>
                                    <Button Command="{Binding BasculerEdition}" ToolTip="Compléter ou corriger les valeurs de l'article">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE70F;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Modifier"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Edition}" Value="True">
                                                                <Setter Property="Text" Value="Terminer la saisie"/>
                                                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding Dupliquer}" Content="Dupliquer" ToolTip="Créer une variante à partir de cet article"/>
                                    <Button Command="{Binding ChercherEnLigne}" ToolTip="{Binding LienVerification}">
                                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE774;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{Binding LibelleVerification}"/></StackPanel>
                                    </Button>
                                    <Button Command="{Binding ValiderProduit}" ToolTip="Après contrôle sur la fiche du fabricant : passe l'article de « indicatif » à « vérifié »">
                                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE73E;" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#6EE7A0"/><TextBlock Text="Valider le produit"/></StackPanel>
                                    </Button>
                                    <Button Command="{Binding Supprimer}" Content="Supprimer"/>
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- Chiffres clés -->
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding ChiffresCles}" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Champ}" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Libelle}" FontSize="10" Foreground="{StaticResource TexteSecondaire}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="Valeur" Text="{Binding Valeur}" FontSize="16" FontWeight="SemiBold" FontFamily="Consolas, Segoe UI"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Valeur}" Value="à compléter">
                                            <Setter TargetName="Valeur" Property="Foreground" Value="{StaticResource Accent}"/>
                                            <Setter TargetName="Valeur" Property="FontSize" Value="13"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TabControl>
                            <TabItem Header="Caractéristiques">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Background="#2A2416" BorderBrush="#5A4520" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10"
                                                Visibility="{Binding Points, Converter={StaticResource NonNulVisible}}">
                                            <StackPanel>
                                                <TextBlock Text="À COMPLÉTER" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,0,4"/>
                                                <ItemsControl ItemsSource="{Binding Points}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock TextWrapping="Wrap" Margin="0,1"><Run Text="! " Foreground="{StaticResource Accent}"/><Run Text="{Binding Mode=OneWay}"/></TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="Cliquez sur « Modifier » pour saisir les valeurs manquantes, puis « Enregistrer »." FontSize="11"
                                                           Foreground="{StaticResource TexteSecondaire}" Margin="0,4,0,0"
                                                           Visibility="{Binding Lecture, Converter={StaticResource VraiVisible}}"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Champs}" ItemTemplate="{StaticResource ModeleChamp}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Encombrement">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" Width="300">
                                        <ItemsControl ItemsSource="{Binding ChampsCotes}" ItemTemplate="{StaticResource ModeleChamp}"/>
                                        <TextBlock Text="{Binding ResumeCotes}" Margin="0,12,0,0" Foreground="{StaticResource TexteSecondaire}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Background="{StaticResource Champ}" CornerRadius="6" Margin="14,0,0,0" Padding="18">
                                        <Grid>
                                            <TextBlock Text="Saisissez les cotes pour voir l'encombrement." Foreground="{StaticResource TexteSecondaire}" TextWrapping="Wrap"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                       Visibility="{Binding ACotes, Converter={StaticResource FauxVisible}}"/>
                                            <DockPanel Visibility="{Binding ACotes, Converter={StaticResource VraiVisible}}">
                                                <TextBlock DockPanel.Dock="Top" Text="Vue de face (L × H), à l'échelle" FontSize="11" Foreground="{StaticResource TexteSecondaire}"/>
                                                <TextBlock DockPanel.Dock="Bottom" HorizontalAlignment="Center" Foreground="{StaticResource Accent}" Margin="0,6,0,0"
                                                           Text="{Binding LargeurCote, StringFormat='L {0:0.#} mm'}"/>
                                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Accent}" Margin="6,0,0,0"
                                                           Text="{Binding HauteurCote, StringFormat='H {0:0.#} mm'}"/>
                                                <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                                                    <Rectangle Width="{Binding LargeurCote}" Height="{Binding HauteurCote}" Fill="#2C333B" Stroke="#C9D1D9" StrokeThickness="1"/>
                                                </Viewbox>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Documents">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TitrePanneau}" Text="PHOTOS"/>
                                        <Border Background="{StaticResource Champ}" CornerRadius="6" Height="220">
                                            <Grid>
                                                <TextBlock Text="Aucune photo : ajoutez une photo du produit (JPG ou PNG)." Foreground="{StaticResource TexteSecondaire}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding APhoto, Converter={StaticResource FauxVisible}}"/>
                                                <Image Source="{Binding PhotoCourante, Converter={StaticResource CheminImage}, ConverterParameter=800}" Stretch="Uniform" Margin="8"/>
                                            </Grid>
                                        </Border>
                                        <WrapPanel Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding Photos}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,8,8">
                                                            <Button Command="{Binding DataContext.ChoisirPhoto, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" Width="64" Height="64" Padding="2" Margin="0" ToolTip="{Binding}">
                                                                <Image Source="{Binding Converter={StaticResource CheminImage}, ConverterParameter=120}" Stretch="Uniform"/>
                                                            </Button>
                                                            <Button Command="{Binding DataContext.RetirerPhoto, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                    Style="{StaticResource BoutonPetit}" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Retirer la photo"
                                                                    Visibility="{Binding DataContext.Edition, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VraiVisible}}">
                                                                <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE711;" FontSize="9"/>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Command="{Binding AjouterPhoto}" Width="64" Height="64" Margin="0,0,8,8" ToolTip="Ajouter une ou plusieurs photos">
                                                <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE710;" FontSize="18"/>
                                            </Button>
                                        </WrapPanel>

                                        <TextBlock Style="{StaticResource TitrePanneau}" Text="FICHES ET PLANS" Margin="0,14,0,8"/>
                                        <TextBlock Text="Aucun document joint." Foreground="{StaticResource TexteSecondaire}"
                                                   Visibility="{Binding DocumentsArticle, Converter={StaticResource FauxVisible}}"/>
                                        <ItemsControl ItemsSource="{Binding DocumentsArticle}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource BoutonPetit}" Margin="6,0,0,0" ToolTip="Retirer"
                                                                Command="{Binding DataContext.RetirerDocument, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding DataContext.Edition, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VraiVisible}}">
                                                            <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE74D;"/>
                                                        </Button>
                                                        <Button Command="{Binding DataContext.OuvrirDocument, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                HorizontalContentAlignment="Left" Margin="0" ToolTip="{Binding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE8A5;" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                                                                <TextBlock Text="{Binding Converter={StaticResource NomFichier}}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Command="{Binding AjouterDocument}" HorizontalAlignment="Left" Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE723;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Joindre une fiche PDF, un plan DXF / STEP…"/></StackPanel>
                                        </Button>

                                        <TextBlock Style="{StaticResource TitrePanneau}" Text="PAGE DU FABRICANT" Margin="0,16,0,6"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Command="{Binding OuvrirLien}" Content="Ouvrir" Margin="6,0,0,0"/>
                                            <TextBox Text="{Binding LienFabricant, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding Lecture}"/>
                                        </DockPanel>

                                        <TextBlock Style="{StaticResource TitrePanneau}" Text="NOTES" Margin="0,16,0,6"/>
                                        <TextBox Text="{Binding NotesArticle, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding Lecture}"
                                                 Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="6,4"
                                                 VerticalScrollBarVisibility="Auto"/>

                                        <CheckBox IsChecked="{Binding Verifie}" IsEnabled="{Binding Edition}" Margin="0,14,0,0">
                                            <TextBlock TextWrapping="Wrap" Text="Valeurs vérifiées sur la fiche du fabricant (l'article passe de « indicatif » à « vérifié »)"/>
                                        </CheckBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Dans le projet">
                                <StackPanel>
                                    <TextBlock Text="Repères du projet ouvert qui utilisent cette référence :" Foreground="{StaticResource TexteSecondaire}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Aucun repère du projet n'utilise cette référence." Foreground="{StaticResource TexteSecondaire}" FontStyle="Italic"
                                               Visibility="{Binding DansLeProjet, Converter={StaticResource FauxVisible}}"/>
                                    <ItemsControl ItemsSource="{Binding DansLeProjet}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Champ}" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Mode=OneWay}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Les modifications enregistrées sont reprises aussitôt dans le calcul du projet." Margin="0,12,0,0"
                                               FontSize="12" Foreground="{StaticResource TexteSecondaire}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="Historique">
                                <StackPanel>
                                    <TextBlock Text="{Binding Historique}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Origine}" Foreground="{StaticResource TexteSecondaire}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock Text="Vos modifications sont enregistrées dans votre dossier utilisateur et conservées lors des mises à jour du logiciel. « Revenir au catalogue livré » (menu ⋯) les abandonne."
                                               Foreground="{StaticResource TexteSecondaire}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
