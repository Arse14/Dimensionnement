<Window x:Class="Dimensionnement.App.Vues.FenetreApercuDevis"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aperçu de la demande de devis" Width="1250" Height="850" MinWidth="700" MinHeight="400"
        Icon="/Ressources/icone.ico"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Fond}"
        Foreground="{StaticResource Texte}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <CollectionViewSource x:Key="Lignes" Source="{Binding LignesDevis}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Categorie"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Style="{StaticResource CadrePanneau}" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BoutonAccent}" Command="{Binding ExporterDevis}" Margin="0">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE719;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Exporter en Excel"/></StackPanel>
                </Button>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TexteSecondaire}" TextWrapping="Wrap"
                           Text="Liste du matériel telle qu'elle partira au fournisseur. Les caractéristiques suffisent à chiffrer même sans référence ; elle suit les modifications du projet."/>
            </DockPanel>
        </Border>
        <DataGrid ItemsSource="{Binding Source={StaticResource Lignes}}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                  Background="{StaticResource Panneau}" RowBackground="{StaticResource Panneau}" AlternatingRowBackground="{StaticResource PanneauClair}"
                  Foreground="{StaticResource Texte}" BorderBrush="{StaticResource Bordure}" HorizontalGridLinesBrush="{StaticResource Bordure}">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="4,10,0,4"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource PanneauClair}"/>
                    <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}"/>
                    <Setter Property="Padding" Value="6,4"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="2*"/>
                <DataGridTextColumn Header="Caractéristiques" Binding="{Binding Caracteristiques}" Width="3*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Fabricant" Binding="{Binding Fabricant}" Width="*"/>
                <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="*"/>
                <DataGridTextColumn Header="Qté" Binding="{Binding Quantite, StringFormat={}{0:0.##}}" Width="50"/>
                <DataGridTextColumn Header="Unité" Binding="{Binding Unite}" Width="50"/>
                <DataGridTextColumn Header="Repères" Binding="{Binding Reperes}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Remarque" Binding="{Binding Remarque}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
