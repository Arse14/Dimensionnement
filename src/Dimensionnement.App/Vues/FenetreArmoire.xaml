<Window x:Class="Dimensionnement.App.Vues.FenetreArmoire"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:Dimensionnement.App.Infrastructure"
        xmlns:calc="clr-namespace:Dimensionnement.Core.Calculs;assembly=Dimensionnement.Core"
        xmlns:arm="clr-namespace:Dimensionnement.Core.Armoire;assembly=Dimensionnement.Core"
        Title="Vue d'armoire" Width="1200" Height="900" MinWidth="800" MinHeight="600"
        Icon="/Ressources/icone.ico"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Fond}"
        Foreground="{StaticResource Texte}" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <DataTemplate x:Key="LigneControle" DataType="{x:Type calc:LigneCalcul}">
            <Border BorderBrush="{StaticResource Bordure}" BorderThickness="0,0,0,1" Padding="0,6">
                <DockPanel>
                    <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,4,8,0" VerticalAlignment="Top"
                             Fill="{Binding Statut, Converter={StaticResource StatutCouleur}}"/>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ValeurTexte}" FontWeight="SemiBold"
                                       FontFamily="Consolas, Segoe UI" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="{Binding Libelle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TexteSecondaire}"
                                   Visibility="{Binding Message, Converter={StaticResource VideMasque}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Style="{StaticResource CadrePanneau}" Margin="0,0,0,8">
            <WrapPanel>
                <CheckBox x:Name="CaseZones" Content="Zones CEM" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <CheckBox x:Name="CaseChamps" Content="Champ magnétique" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <CheckBox x:Name="CaseIhm" Content="IHM en porte" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"
                          ToolTip="Affiche ou masque les IHM encastrées dans la porte ; elles restent comptées (découpe, profondeur)"/>
                <Button Content="Ajouter un rail DIN" Command="{Binding AjouterRail}" Margin="0,0,6,0"/>
                <Button Content="Ajouter une goulotte horizontale" Command="{Binding AjouterGoulotte}" CommandParameter="H" Margin="0,0,6,0"/>
                <Button Content="Ajouter une goulotte verticale" Command="{Binding AjouterGoulotte}" CommandParameter="V" Margin="0,0,16,0"/>
                <Button Content="Modifier à la main" Command="{Binding ImplantationLibre}" Margin="0,0,6,0"
                        ToolTip="La disposition calculée devient la tienne : rails DIN, goulottes et appareils se déplacent, se changent ou se suppriment (clic droit). Place libre, chevauchements et profondeur sont recalculés sur ta disposition. « Réinitialiser l'implantation » revient au calcul automatique."/>
                <Button Content="Réinitialiser l'implantation" Command="{Binding ReinitialiserImplantation}" Margin="0,0,16,0"/>
                <TextBlock Text="Afficher" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding ChoixArmoires}" SelectedItem="{Binding ArmoireChoisie}" DisplayMemberPath="Libelle"
                          Width="180" Margin="0,0,6,0"
                          ToolTip="Armoire principale ou coffret déporté. Clic droit sur un appareil pour le déporter, seul ou avec tout son départ."/>
                <TextBox Text="{Binding NomCoffret, UpdateSourceTrigger=LostFocus}" Width="140" VerticalAlignment="Center" Margin="0,0,6,0"
                         ToolTip="Nom du coffret déporté" Visibility="{Binding CoffretAffiche, Converter={StaticResource VraiVisible}}"/>
                <Button Content="Supprimer ce coffret" Command="{Binding SupprimerCoffret}" Margin="0,0,16,0"
                        ToolTip="Son matériel revient dans l'armoire principale."
                        Visibility="{Binding CoffretAffiche, Converter={StaticResource VraiVisible}}"/>
                <TextBlock Text="Enveloppe" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding ChoixEnveloppes}" SelectedItem="{Binding EnveloppeAffichee}" DisplayMemberPath="Libelle"
                          Width="420" MaxDropDownHeight="420" IsTextSearchEnabled="True" TextSearch.TextPath="Libelle" Margin="0,0,16,0"
                          ToolTip="Choisir une enveloppe du catalogue l'impose (marque et cotes reprises) ; « Automatique » prend la plus petite qui reçoit le matériel ; les cotes libres se saisissent dans le panneau Armoire et implantation."/>
                <TextBlock Text="Place libre (%)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding PlaceLibre, UpdateSourceTrigger=LostFocus}" Width="50" VerticalAlignment="Center" Margin="0,0,16,0"
                         ToolTip="Place à laisser libre sur les rails pour les évolutions. Dans une enveloppe imposée trop juste, elle est gardée en priorité : les goulottes sont d'abord réduites, puis la place libre si besoin."/>
                <TextBlock Text="{Binding ResumeArmoire}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4,0,0"/>
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="#3A1F22" BorderBrush="#F85149" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,8"
                Visibility="{Binding ArmoireAffichee.Alerte, Converter={StaticResource VideMasque}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource Icones}" Text="&#xE7BA;" Foreground="#F85149" FontSize="16" Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right" Content="Déporter ce qui n'entre pas dans un coffret" Command="{Binding DeporterCeQuiNEntrePas}"
                        Margin="8,0,0,0" ToolTip="Crée un coffret dimensionné pour le matériel de la zone « À placer », avec le reste de leurs départs."
                        Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource VraiVisible}}"/>
                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding ArmoireAffichee.Alerte}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Right" Width="380" Style="{StaticResource CadrePanneau}" Margin="8,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <CheckBox x:Name="CaseExplications" DockPanel.Dock="Right" Content="Comment c'est calculé ?" VerticalAlignment="Center"
                              ToolTip="Explique comment sont obtenus l'encombrement, les zones, les rangées, les borniers, l'enveloppe, les goulottes et le champ magnétique."/>
                    <TextBlock Text="CONTRÔLES DE L'IMPLANTATION" Style="{StaticResource TitrePanneau}"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource TexteSecondaire}" Margin="0,0,0,8"
                           Text="Glissez un appareil, un rail ou une goulotte ajoutés pour les déplacer (pas de 5 mm) ; clic droit sur un appareil pour le renommer, sur un rail ou une goulotte ajoutés pour sa longueur, son modèle ou sa suppression. Survolez un appareil pour ses cotes et le champ qu'il reçoit ou émet."/>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsChecked, ElementName=CaseExplications, Converter={StaticResource FauxVisible}}">
                        <ItemsControl ItemsSource="{Binding ArmoireAffichee.Note.Lignes}" ItemTemplate="{StaticResource LigneControle}"/>
                    </ScrollViewer>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsChecked, ElementName=CaseExplications, Converter={StaticResource VraiVisible}}">
                        <ItemsControl ItemsSource="{x:Static arm:ExplicationsArmoire.Rubriques}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type arm:Explication}">
                                    <Border BorderBrush="{StaticResource Bordure}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Titre}" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                            <TextBlock Text="{Binding Texte}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource CadrePanneau}" ClipToBounds="True">
            <inf:VueArmoire Interactif="True" Background="{StaticResource Champ}"
                            Armoire="{Binding ArmoireAffichee}"
                            DeporterCommande="{Binding Deporter}"
                            Destinations="{Binding DestinationsDeport}"
                            AfficherZones="{Binding IsChecked, ElementName=CaseZones}"
                            AfficherChamps="{Binding IsChecked, ElementName=CaseChamps}"
                            AfficherIhm="{Binding IsChecked, ElementName=CaseIhm}"
                            DeplacerCommande="{Binding DeplacerAppareil}"
                            ActionCommande="{Binding ModifierArmoire}"
                            RenommerCommande="{Binding RenommerElement}"
                            LibreCommande="{Binding ImplantationLibre}"/>
        </Border>
    </DockPanel>
</Window>
