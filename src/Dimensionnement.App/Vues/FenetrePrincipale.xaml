                                    <DockPanel Style="{StaticResource Ligne}">
                                        <TextBlock Text="Départs coupés (ex. 1, 3, 4)" Style="{StaticResource Etiquette}"/>
                                        <TextBox Text="{inf:Lien DepartsTexte}"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Ligne}">
                                        <TextBlock Text="Sorties de sécurité en plus (voyants, freins…)" Style="{StaticResource Etiquette}"/>
                                        <TextBox Text="{inf:Lien SortiesSupplementaires}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
