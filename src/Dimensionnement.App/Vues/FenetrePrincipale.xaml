<Window x:Class="Dimensionnement.App.Vues.FenetrePrincipale"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:Dimensionnement.App.Infrastructure"
        xmlns:mod="clr-namespace:Dimensionnement.Core.Modele;assembly=Dimensionnement.Core"
        xmlns:mat="clr-namespace:Dimensionnement.Core.Materiel;assembly=Dimensionnement.Core"
        xmlns:calc="clr-namespace:Dimensionnement.Core.Calculs;assembly=Dimensionnement.Core"
        xmlns:mv="clr-namespace:Dimensionnement.App.ModelesVue"
        Title="{Binding Titre}" Width="1440" Height="880" MinWidth="1100" MinHeight="640"
        Icon="/Ressources/icone.ico"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Fond}"
        Foreground="{StaticResource Texte}" FontFamily="Segoe UI" FontSize="13"
        Closing="Fermeture">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding Nouveau}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding Ouvrir}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Enregistrer}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding ApercuRapport}"/>
        <KeyBinding Key="Delete" Command="{Binding Supprimer}"/>
    </Window.InputBindings>

    <Window.Resources>

        <!-- Conditions de pose d'un câble -->
        <DataTemplate x:Key="ChampsCable" DataType="{x:Type mod:CaracteristiquesCable}">
            <StackPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Longueur (m)" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien Longueur}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Mode de pose" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.Poses}" SelectedItem="{inf:Lien Pose}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Isolant" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.Isolants}" SelectedItem="{inf:Lien Isolant}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Circuits jointifs (groupement)" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien CircuitsGroupes}"/>
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Champs communs à tous les départs -->
        <DataTemplate x:Key="ChampsDepart" DataType="{x:Type mod:Depart}">
            <StackPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Désignation" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien Designation}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Rubrique de l'armoire" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.Rubriques}" SelectedItem="{inf:Lien Rubrique}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Alimentation" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.Alimentations}" SelectedItem="{inf:Lien Alimentation}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Protection différentielle" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.Differentiels}" SelectedItem="{inf:Lien Differentiel}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Protection contre les surintensités" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.Protections}" SelectedItem="{inf:Lien Protection}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Coefficient d'utilisation ku" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien CoefficientUtilisation}"/>
                </DockPanel>

                <TextBlock Text="Câble du départ" Style="{StaticResource Section}"/>
                <ContentControl Content="{Binding Cable}" ContentTemplate="{StaticResource ChampsCable}"/>
            </StackPanel>
        </DataTemplate>


        <!-- Projet et réseau -->
        <DataTemplate DataType="{x:Type mod:Projet}">
            <StackPanel>
                <TextBlock Text="PROJET ET RÉSEAU D'ALIMENTATION" Style="{StaticResource TitrePanneau}"/>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Nom du projet" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien Nom}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="N° d'affaire" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien Affaire}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Client" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien Client}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Auteur" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien Auteur}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Indice de révision" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien Indice}"/>
                </DockPanel>

                <TextBlock Text="Réseau" Style="{StaticResource Section}"/>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Alimentation" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.Alimentations}" SelectedItem="{inf:Lien Reseau.Alimentation}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Schéma de liaison à la terre" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.Slt}" SelectedItem="{inf:Lien Reseau.Slt}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Origine de l'alimentation" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.Origines}" SelectedItem="{inf:Lien Reseau.Origine}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Icc présumé à l'arrivée (kA)" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien Reseau.IccKiloAmperes}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Température ambiante (°C)" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien Reseau.TemperatureAmbiante}"/>
                </DockPanel>

                <TextBlock Text="Câble d'arrivée" Style="{StaticResource Section}"/>
                <ContentControl Content="{Binding Reseau.CableArrivee}" ContentTemplate="{StaticResource ChampsCable}"/>

                <TextBlock Text="Circuits de commande" Style="{StaticResource Section}"/>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Tension des bobines de contacteurs" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.TensionsCommande}" SelectedItem="{inf:Lien TensionBobines}"
                              ToolTip="Les bobines sont comptées sur la source de cette tension ; les références des contacteurs suivent (BD, B7, P7…)."/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Ajouter automatiquement les sources" Style="{StaticResource Etiquette}"/>
                    <CheckBox IsChecked="{inf:Lien AjoutAutomatiqueSources}"
                              ToolTip="Quand un élément demande une tension qu'aucune source ne fournit (24 V DC, 24 V AC, 230 V sans neutre), l'alimentation ou le transformateur est ajouté."/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Source 24 V DC préférée" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.PreferencesSource}" SelectedItem="{inf:Lien PreferenceSource}"/>
                </DockPanel>

                <TextBlock Text="Marques du matériel" Style="{StaticResource Section}"/>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Fabricant du projet" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.FabricantsMateriel}" SelectedItem="{inf:Lien References.Fabricant}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Disjoncteurs" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.MarquesFamille}" SelectedItem="{inf:Lien References.MarqueDisjoncteurs}"
                              ToolTip="Disjoncteurs, disjoncteurs moteurs et interrupteurs-sectionneurs."/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Contacteurs" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.MarquesFamille}" SelectedItem="{inf:Lien References.MarqueContacteurs}"
                              ToolTip="Contacteurs et relais thermiques."/>
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type mod:DepartMoteur}">
            <StackPanel>
                <TextBlock Style="{StaticResource TitrePanneau}">
                    <Run Text="DÉPART MOTEUR D"/><Run Text="{Binding Numero, Mode=OneWay, StringFormat={}{0:00}}"/>
                </TextBlock>
                <TextBlock Text="Plaque signalétique" Style="{StaticResource Section}" Margin="0,0,0,6"/>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Puissance utile Pn (kW)" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien PuissanceKw}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Courant nominal In (A, 0 = calculé)" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien CourantPlaque}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="cos φ" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien CosPhi}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Rendement η" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien Rendement}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Id / In" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien RapportId}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Mode de démarrage" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.Demarrages}" SelectedItem="{inf:Lien Demarrage}"/>
                </DockPanel>
                <DockPanel>
                    <DockPanel.Style>
                        <Style TargetType="DockPanel" BasedOn="{StaticResource Ligne}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Demarrage}" Value="{x:Static mod:ModeDemarrage.Variateur}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <TextBlock Text="Marque du variateur" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.MarquesVariateur}" SelectedItem="{inf:Lien MarqueVariateur}"
                              ItemTemplate="{StaticResource ModeleEnum}"
                              ToolTip="Le modèle, sa taille et son encombrement sont donnés dans la note de calcul (ligne « Variateur retenu »)."/>
                </DockPanel>
                <TextBlock Text="Départ" Style="{StaticResource Section}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ChampsDepart}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type mod:DepartResistif}">
            <StackPanel>
                <TextBlock Style="{StaticResource TitrePanneau}">
                    <Run Text="DÉPART RÉSISTIF D"/><Run Text="{Binding Numero, Mode=OneWay, StringFormat={}{0:00}}"/>
                </TextBlock>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Puissance (kW)" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien PuissanceKw}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Commandé par contacteur" Style="{StaticResource Etiquette}"/>
                    <CheckBox IsChecked="{inf:Lien AvecContacteur}"/>
                </DockPanel>
                <TextBlock Text="Départ" Style="{StaticResource Section}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ChampsDepart}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type mod:DepartPrise}">
            <StackPanel>
                <TextBlock Style="{StaticResource TitrePanneau}">
                    <Run Text="CIRCUIT PRISES D"/><Run Text="{Binding Numero, Mode=OneWay, StringFormat={}{0:00}}"/>
                </TextBlock>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Calibre des prises (A)" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien CalibrePrise}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Nombre de prises" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien NombrePrises}"/>
                </DockPanel>
                <TextBlock Text="Départ" Style="{StaticResource Section}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ChampsDepart}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type mod:DepartGenerique}">
            <StackPanel>
                <TextBlock Style="{StaticResource TitrePanneau}">
                    <Run Text="CHARGE GÉNÉRIQUE D"/><Run Text="{Binding Numero, Mode=OneWay, StringFormat={}{0:00}}"/>
                </TextBlock>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Puissance absorbée (kW)" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien PuissanceKw}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="cos φ" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien CosPhi}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Courbe du disjoncteur" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.Courbes}" SelectedItem="{inf:Lien Courbe}"/>
                </DockPanel>
                <TextBlock Text="Départ" Style="{StaticResource Section}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ChampsDepart}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type mod:DepartAlimentation24V}">
            <StackPanel>
                <TextBlock Style="{StaticResource TitrePanneau}">
                    <Run Text="{Binding TypeLibelle, Mode=OneWay}"/><Run Text=" – D"/><Run Text="{Binding Numero, Mode=OneWay, StringFormat={}{0:00}}"/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TexteSecondaire}" Margin="0,0,0,8"
                           Text="Dimensionnée sur les consommateurs de la commande raccordés à cette source (automate, IHM, sécurité, bobines, capteurs, consommateurs déclarés) : voir la note de calcul et la page « Bilan 24 V »."/>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Technologie" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.SourcesAlimentation}" SelectedItem="{inf:Lien Source}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Tension de sortie" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.TensionsCommande}" SelectedItem="{inf:Lien Sortie}"
                              ToolTip="24 V AC et 230 V AC imposent un transformateur ; 24 V DC par transformateur ajoute un redresseur filtré."/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Marque" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.MarquesAlimentation}" SelectedItem="{inf:Lien Marque}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Partie de la commande desservie" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.Usages24V}" SelectedItem="{inf:Lien Usage}"
                              ToolTip="Plusieurs sources de même usage et de même tension se partagent la charge."/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Départs 230 V alimentés (n°)" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien DepartsAlimentesTexte}"
                             ToolTip="Transformateur 400/230 V : numéros des départs qu'il alimente, séparés par des virgules (ex. 3, 5, 7). Ils sont comptés au primaire."/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Réserve (%)" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien ReservePourcent}"/>
                </DockPanel>

                <TextBlock Text="Saisie manuelle" Style="{StaticResource Section}"/>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Modèle saisi à la main" Style="{StaticResource Etiquette}"/>
                    <CheckBox IsChecked="{inf:Lien Manuelle}" ToolTip="Quand le catalogue n'a rien qui convienne : ses caractéristiques sont vérifiées contre le besoin."/>
                </DockPanel>
                <StackPanel Visibility="{Binding Manuelle, Converter={StaticResource VraiVisible}}">
                    <DockPanel Style="{StaticResource Ligne}">
                        <TextBlock Text="Fabricant" Style="{StaticResource Etiquette}"/>
                        <TextBox Text="{inf:Lien FabricantManuel}"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Ligne}">
                        <TextBlock Text="Référence" Style="{StaticResource Etiquette}"/>
                        <TextBox Text="{inf:Lien ReferenceManuelle}"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Ligne}">
                        <TextBlock Text="Courant de sortie (A)" Style="{StaticResource Etiquette}"/>
                        <TextBox Text="{inf:Lien CourantManuel}"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Ligne}">
                        <TextBlock Text="Rendement" Style="{StaticResource Etiquette}"/>
                        <TextBox Text="{inf:Lien Rendement}"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Ligne}">
                        <TextBlock Text="Largeur × hauteur × profondeur (mm)" Style="{StaticResource Etiquette}"/>
                        <UniformGrid Rows="1">
                            <TextBox Text="{inf:Lien LargeurManuelle}"/>
                            <TextBox Text="{inf:Lien HauteurManuelle}" Margin="4,0"/>
                            <TextBox Text="{inf:Lien ProfondeurManuelle}"/>
                        </UniformGrid>
                    </DockPanel>
                </StackPanel>
                <Button Content="Catalogue des alimentations et transformateurs" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Command="{Binding DataContext.OuvrirCatalogueAlimentations, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <TextBlock Text="Départ" Style="{StaticResource Section}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ChampsDepart}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Bilan 24 V DC -->
        <DataTemplate DataType="{x:Type mv:PageBilan24V}">
            <StackPanel>
                <TextBlock Text="BILAN DE LA COMMANDE (24 V DC, 24 V AC, 230 V AC)" Style="{StaticResource TitrePanneau}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TexteSecondaire}" Margin="0,0,0,8"
                           Text="Consommateurs déclarés à la main ; l'automate, ses cartes, les IHM et la logique de sécurité sont ajoutés automatiquement."/>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Estimer bobines, capteurs et actionneurs" Style="{StaticResource Etiquette}"/>
                    <CheckBox IsChecked="{inf:Lien Projet.EstimerPeripherie24V}"
                              ToolTip="Bobines de contacteurs (selon leur tension), capteurs sur entrées et actionneurs sur sorties de l'automate."/>
                </DockPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/><ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Désignation" Foreground="{StaticResource TexteSecondaire}"/>
                    <TextBlock Grid.Column="1" Text="Tension" Foreground="{StaticResource TexteSecondaire}" Margin="6,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="mA unitaire" Foreground="{StaticResource TexteSecondaire}" Margin="6,0,0,0"/>
                    <TextBlock Grid.Column="3" Text="Quantité" Foreground="{StaticResource TexteSecondaire}" Margin="6,0,0,0"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Projet.Consommateurs24V}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type mod:Consommateur24V}">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/><ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{inf:Lien Designation}"/>
                                <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{x:Static inf:Listes.TensionsConsommateur}" SelectedItem="{inf:Lien Tension}"/>
                                <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{inf:Lien CourantMa}"/>
                                <TextBox Grid.Column="3" Margin="6,0,0,0" Text="{inf:Lien Quantite}"/>
                                <Button Grid.Column="4" Margin="6,0,0,0" Style="{StaticResource BoutonPetit}" ToolTip="Retirer"
                                        Command="{Binding DataContext.SupprimerConsommateur, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE711;"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Ajouter un consommateur" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Command="{Binding DataContext.AjouterConsommateur, RelativeSource={RelativeSource AncestorType=Window}}"/>

                <TextBlock Text="Bilan retenu" Style="{StaticResource Section}"/>
                <ItemsControl ItemsSource="{Binding DataContext.Resultat.Consommateurs24V, RelativeSource={RelativeSource AncestorType=Window}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Courant, StringFormat={}{0:0.000} A}" FontFamily="Consolas, Segoe UI"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Tension, Converter={StaticResource LibelleEnum}}" Width="70" Foreground="{StaticResource TexteSecondaire}"/>
                                <TextBlock Text="{Binding Designation}" Foreground="{StaticResource TexteSecondaire}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource Accent}" FontFamily="Consolas, Segoe UI"
                               Text="{Binding DataContext.Resultat.Consommation24V, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0:0.000} A}"/>
                    <TextBlock Text="Total 24 V DC" FontWeight="SemiBold"/>
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Bilan de puissance expliqué -->
        <DataTemplate DataType="{x:Type mv:PageBilanPuissance}">
            <StackPanel>
                <TextBlock Text="BILAN DE PUISSANCE" Style="{StaticResource TitrePanneau}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TexteSecondaire}" Margin="0,0,0,8"
                           Text="Du récepteur au câble d'arrivée : chaque étape dit ce qui est calculé, pourquoi, avec quelle formule, et le résultat pour ce projet."/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="64"/><ColumnDefinition Width="44"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Départ" Foreground="{StaticResource TexteSecondaire}"/>
                    <TextBlock Grid.Column="1" Text="P (kW)" TextAlignment="Right" Foreground="{StaticResource TexteSecondaire}"/>
                    <TextBlock Grid.Column="2" Text="Q (kvar)" TextAlignment="Right" Foreground="{StaticResource TexteSecondaire}"/>
                    <TextBlock Grid.Column="3" Text="ku" TextAlignment="Right" Foreground="{StaticResource TexteSecondaire}"/>
                    <TextBlock Grid.Column="4" Text="P × ku" TextAlignment="Right" Foreground="{StaticResource TexteSecondaire}"/>
                    <TextBlock Grid.Column="5" Text="Q × ku" TextAlignment="Right" Foreground="{StaticResource TexteSecondaire}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding DataContext.LignesBilan, RelativeSource={RelativeSource AncestorType=Window}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Bordure}" BorderThickness="0,0,0,1" Padding="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="64"/><ColumnDefinition Width="44"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Depart}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Remarque}" FontSize="11" Foreground="{StaticResource TexteSecondaire}" TextWrapping="Wrap"
                                                   Visibility="{Binding Remarque, Converter={StaticResource VideMasque}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding P, StringFormat={}{0:0.00}}" TextAlignment="Right" FontFamily="Consolas, Segoe UI"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Q, StringFormat={}{0:0.00}}" TextAlignment="Right" FontFamily="Consolas, Segoe UI"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Ku, StringFormat={}{0:0.##}}" TextAlignment="Right" FontFamily="Consolas, Segoe UI"/>
