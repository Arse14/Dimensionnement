                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Ambiance maximale (°C)" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien Projet.Armoire.TemperatureAmbianteMax}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Ambiance minimale (°C)" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien Projet.Armoire.TemperatureAmbianteMin}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Intérieur maximal admis (°C)" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien Projet.Armoire.TemperatureInterieureMax}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Intérieur minimal (°C)" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{inf:Lien Projet.Armoire.TemperatureInterieureMin}"/>
                </DockPanel>

                <TextBlock Text="Pertes des appareils à leur courant de service" Style="{StaticResource Section}"/>
                <ItemsControl ItemsSource="{Binding DataContext.Resultat.Thermique.Postes, RelativeSource={RelativeSource AncestorType=Window}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PuissanceW, StringFormat={}{0:0.0} W}" FontFamily="Consolas, Segoe UI"/>
                                <TextBlock Text="{Binding Repere}" FontWeight="SemiBold" MinWidth="64"/>
                                <TextBlock Text="{Binding Designation}" Foreground="{StaticResource TexteSecondaire}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource Accent}" FontFamily="Consolas, Segoe UI"
                               Text="{Binding DataContext.Resultat.Thermique.PuissanceDissipee, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0:0} W}"/>
                    <TextBlock Text="Total retenu, câblage compris" FontWeight="SemiBold"/>
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Sélectivité -->
        <DataTemplate DataType="{x:Type mv:PageSelectivite}">
            <StackPanel>
                <TextBlock Text="SÉLECTIVITÉ GÉNÉRAL / DÉPARTS" Style="{StaticResource TitrePanneau}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TexteSecondaire}" Margin="0,0,0,8"
                           Text="Sélectivité ampèremétrique minimale ; les tables de sélectivité du fabricant donnent souvent mieux."/>
                <ItemsControl ItemsSource="{Binding DataContext.Resultat.Selectivite.Lignes, RelativeSource={RelativeSource AncestorType=Window}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type calc:LigneSelectivite}">
                            <Border Background="{StaticResource PanneauClair}" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                                   Text="{Binding Niveau, Converter={StaticResource LibelleEnum}}"/>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding Depart, Mode=OneWay}"/><Run Text=" : "/><Run Text="{Binding Amont, Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding Aval, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DockPanel>
                                    <TextBlock Foreground="{StaticResource TexteSecondaire}" Margin="0,2,0,0">
                                        <Run Text="Rapport des calibres "/><Run Text="{Binding RapportSurcharge, Mode=OneWay, StringFormat={}{0:0.00}}"/>
                                        <Run Text=" – magnétique amont "/><Run Text="{Binding SeuilAmont, Mode=OneWay, StringFormat={}{0:0} A}"/>
                                        <Run Text=", aval "/><Run Text="{Binding SeuilAval, Mode=OneWay, StringFormat={}{0:0} A}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Commentaire}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Références fabricants -->
        <DataTemplate DataType="{x:Type mv:PageReferences}">
            <StackPanel>
                <TextBlock Text="RÉFÉRENCES DU MATÉRIEL" Style="{StaticResource TitrePanneau}"/>
                <DockPanel Style="{StaticResource Ligne}">
                    <TextBlock Text="Fabricant de la puissance" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{x:Static inf:Listes.FabricantsMateriel}" SelectedItem="{inf:Lien Projet.References.Fabricant}"/>
                </DockPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TexteSecondaire}" Margin="0,4,0,8"
                           Text="Références indicatives à confirmer sur le configurateur du fabricant. Saisissez une référence pour remplacer celle du catalogue ; videz la case pour revenir au catalogue."/>
                <ItemsControl ItemsSource="{Binding DataContext.LignesReferences, RelativeSource={RelativeSource AncestorType=Window}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type mv:LigneReference}">
                            <Border BorderBrush="{StaticResource Bordure}" BorderThickness="0,0,0,1" Padding="0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Repere}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Designation}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TexteSecondaire}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Calibre, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding Fabricant, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBox Grid.Column="2" Text="{inf:Lien Reference}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource BoutonAccent}" Content="Demande de devis (Excel)" Margin="0,0,6,6"
                            Command="{Binding DataContext.ExporterDevis, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="Ouvrir le catalogue" Margin="0,0,6,6"
                            Command="{Binding DataContext.OuvrirCatalogueReferences, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="Catalogue des variateurs" Margin="0,0,6,6"
                            Command="{Binding DataContext.OuvrirCatalogueVariateurs, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="Catalogue des enveloppes" Margin="0,0,6,6"
                            Command="{Binding DataContext.OuvrirCatalogueEnveloppes, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="Recharger les catalogues" Margin="0,0,6,6"
                            Command="{Binding DataContext.RechargerCatalogueReferences, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Matériel en cartes : une carte par départ, la chaîne d'appareils de l'amont vers l'aval -->
        <Style x:Key="BoutonCarte" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="Background" Value="{StaticResource PanneauClair}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Survol}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource MemeDepart}">
                            <Binding Path="Depart"/>
                            <Binding Path="DataContext.Selection" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource Selection}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="MaillonMateriel" DataType="{x:Type mat:MaillonMateriel}">
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="Lien" Text="→" Foreground="{StaticResource TexteSecondaire}" Margin="3,0" VerticalAlignment="Center"/>
                <Border Background="{StaticResource Champ}" CornerRadius="3" Padding="6,2"
                        ToolTip="{Binding Element.Designation}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center"
                                 Fill="{Binding Element.Statut, Converter={StaticResource StatutCouleur}}"/>
                        <TextBlock Text="{Binding Element.Repere}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Element.Calibre}" Foreground="{StaticResource TexteSecondaire}" FontSize="11.5"
                                   Margin="6,0,0,0" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Element.Calibre, Converter={StaticResource VideMasque}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding EnParallele}" Value="True">
                    <Setter TargetName="Lien" Property="Text" Value="∥"/>
                    <Setter TargetName="Lien" Property="ToolTip" Value="En parallèle de l'appareil précédent"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter TargetName="Lien" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CarteMateriel" DataType="{x:Type mat:CarteMateriel}">
            <Button Style="{StaticResource BoutonCarte}" CommandParameter="{Binding}"
                    Command="{Binding DataContext.OuvrirCarte, RelativeSource={RelativeSource AncestorType=Window}}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="4,0,0,4"
                            Background="{Binding Statut, Converter={StaticResource StatutCouleur}}"/>
                    <StackPanel Margin="10,7,8,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SousTitre}" Foreground="{StaticResource TexteSecondaire}"
                                       FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Titre}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Chaine}" ItemTemplate="{StaticResource MaillonMateriel}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="GroupeMateriel" DataType="{x:Type mat:GroupeMateriel}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Titre}" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11.5" Margin="2,4,0,6"/>
                <ItemsControl ItemsSource="{Binding Cartes}" ItemTemplate="{StaticResource CarteMateriel}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Ligne de note de calcul -->
        <DataTemplate x:Key="LigneNote" DataType="{x:Type calc:LigneCalcul}">
            <Border BorderBrush="{StaticResource Bordure}" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,4,0,0"
                             Fill="{Binding Statut, Converter={StaticResource StatutCouleur}}"/>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ValeurTexte}" FontWeight="SemiBold"
                                       FontFamily="Consolas, Segoe UI" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="{Binding Libelle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Formule}" Foreground="{StaticResource TexteSecondaire}" TextWrapping="Wrap"
                                   Visibility="{Binding Formule, Converter={StaticResource VideMasque}}"/>
                        <TextBlock Text="{Binding Entrees}" Foreground="{StaticResource TexteSecondaire}" TextWrapping="Wrap"
                                   Visibility="{Binding Entrees, Converter={StaticResource VideMasque}}"/>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                   Visibility="{Binding Message, Converter={StaticResource VideMasque}}"/>
                        <TextBlock Foreground="{StaticResource TexteSecondaire}" FontSize="11" FontStyle="Italic">
                            <Run Text="{Binding Identifiant, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding Reference, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <Button x:Name="BoutonForcer" Content="Forcer" Style="{StaticResource BoutonPetit}" Visibility="Collapsed"
                                Command="{Binding DataContext.Forcer, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button x:Name="BoutonAnnuler" Content="Rétablir le calcul" Style="{StaticResource BoutonPetit}"
                                Command="{Binding DataContext.AnnulerForcage, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Forcable}" Value="True"/>
                        <Condition Binding="{Binding Forcage}" Value="{x:Null}"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="BoutonForcer" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Forcage}" Value="{x:Null}">
                    <Setter TargetName="BoutonAnnuler" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Bouton de la barre d'outils : icône et libellé -->
        <Style x:Key="BoutonOutil" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Barre d'outils -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panneau}" BorderBrush="{StaticResource Bordure}"
                BorderThickness="0,0,0,1" Padding="10,6">
            <!-- Les boutons passent à la ligne quand la fenêtre est étroite. -->
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Image Source="/Ressources/logo-256.png" Width="24" Height="24" VerticalAlignment="Center" Margin="2,0,0,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="DIMENSIONNEMENT" FontWeight="Bold" Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center" Margin="4,0,18,0" FontSize="14"/>
                    <Button Style="{StaticResource BoutonOutil}" Command="{Binding Nouveau}" ToolTip="Nouveau projet (Ctrl+N)">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE8A5;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Nouveau"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonOutil}" Command="{Binding Ouvrir}" ToolTip="Ouvrir un projet (Ctrl+O)">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE8E5;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Ouvrir"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonOutil}" Click="AfficherRecents" ToolTip="Projets récents">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE81C;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Récents"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonOutil}" Command="{Binding Enregistrer}" ToolTip="Enregistrer (Ctrl+S)">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE74E;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Enregistrer"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonOutil}" Command="{Binding EnregistrerSous}" ToolTip="Enregistrer sous… (dupliquer le projet)">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE792;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Enregistrer sous"/></StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{StaticResource Bordure}" Margin="8,2"/>
                    <Button Style="{StaticResource BoutonOutil}" Click="AfficherAjouts" ToolTip="Ajouter un départ">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Moteur, démarrage direct" Command="{Binding AjouterMoteur}" CommandParameter="{x:Static mod:ModeDemarrage.Direct}"/>
                                <MenuItem Header="Moteur deux sens (inverseur)" Command="{Binding AjouterMoteur}" CommandParameter="{x:Static mod:ModeDemarrage.Inverseur}"/>
                                <MenuItem Header="Moteur étoile-triangle" Command="{Binding AjouterMoteur}" CommandParameter="{x:Static mod:ModeDemarrage.EtoileTriangle}"/>
                                <MenuItem Header="Moteur sur variateur de fréquence" Command="{Binding AjouterMoteur}" CommandParameter="{x:Static mod:ModeDemarrage.Variateur}"/>
                                <MenuItem Header="Moteur sur démarreur progressif" Command="{Binding AjouterMoteur}" CommandParameter="{x:Static mod:ModeDemarrage.DemarreurProgressif}"/>
                                <Separator/>
                                <MenuItem Header="Résistance (chauffage)" Command="{Binding AjouterResistif}"/>
                                <MenuItem Header="Prise de courant" Command="{Binding AjouterPrise}"/>
                                <MenuItem Header="Autre charge" Command="{Binding AjouterGenerique}"/>
                                <Separator/>
                                <MenuItem Header="Alimentation 24 V DC" Command="{Binding AjouterAlimentation}"/>
                                <MenuItem Header="Transformateur 400/24 V AC" Command="{Binding AjouterTransformateur}" CommandParameter="{x:Static mod:TensionCommande.Alternatif24}"/>
                                <MenuItem Header="Transformateur + redresseur 24 V DC" Command="{Binding AjouterTransformateur}" CommandParameter="{x:Static mod:TensionCommande.Continu24}"/>
                                <MenuItem Header="Transformateur 400/230 V" Command="{Binding AjouterTransformateur}" CommandParameter="{x:Static mod:TensionCommande.Alternatif230}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE710;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Ajouter"/><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE70D;" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonOutil}" Command="{Binding Supprimer}" ToolTip="Supprimer le départ sélectionné (Suppr)">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE74D;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Supprimer"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding OuvrirCatalogues}" ToolTip="Catalogues du matériel : tableau filtrable, fiches techniques, photos et documents ; complétez les valeurs manquantes">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE8F1;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Catalogues"/></StackPanel>
                    </Button>
                    <Button Command="{Binding OuvrirVueArmoire}" ToolTip="Vue de face de l'armoire, zones CEM et champs ; déplacement des appareils à la souris">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE80F;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Armoire"/></StackPanel>
                    </Button>
                    <Button Command="{Binding ApercuDevis}" ToolTip="Aperçu de la liste exhaustive du matériel à envoyer au fournisseur, puis export Excel">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE719;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Demande de devis"/></StackPanel>
                    </Button>
                    <Button Command="{Binding ExporterExcel}" ToolTip="Nomenclature, départs, notes de calcul et contrôles au format Excel">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE80A;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Excel"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonAccent}" Command="{Binding ApercuRapport}" Margin="0"
                            ToolTip="Aperçu du rapport complet du projet, puis génération du PDF (Ctrl+P)">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE749;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Rapport PDF"/></StackPanel>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Barre d'état -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panneau}" BorderBrush="{StaticResource Bordure}"
                BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource TexteSecondaire}"
                           Text="Aide au dimensionnement : résultats à valider par le bureau d'étude"/>
                <TextBlock Text="{Binding Chemin}" Foreground="{StaticResource TexteSecondaire}"/>
            </DockPanel>
        </Border>

        <!-- Bandeau de synthèse -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panneau}" BorderBrush="{StaticResource Bordure}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <UniformGrid Rows="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center"
                             Fill="{Binding Resultat.StatutGlobal, Converter={StaticResource StatutCouleur}}"/>
                    <StackPanel>
                        <TextBlock Text="ALERTES" Style="{StaticResource IndicateurLibelle}"/>
                        <TextBlock Text="{Binding Resultat.NombreAlertes}" Style="{StaticResource IndicateurValeur}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="PUISSANCE ACTIVE" Style="{StaticResource IndicateurLibelle}"/>
                    <TextBlock Text="{Binding Resultat.PuissanceActive, StringFormat={}{0:0.0} kW}" Style="{StaticResource IndicateurValeur}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="PUISSANCE APPARENTE" Style="{StaticResource IndicateurLibelle}"/>
                    <TextBlock Text="{Binding Resultat.PuissanceApparente, StringFormat={}{0:0.0} kVA}" Style="{StaticResource IndicateurValeur}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="COS φ GLOBAL" Style="{StaticResource IndicateurLibelle}"/>
                    <TextBlock Text="{Binding Resultat.CosPhiGlobal, StringFormat={}{0:0.00}}" Style="{StaticResource IndicateurValeur}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="COURANT D'EMPLOI" Style="{StaticResource IndicateurLibelle}"/>
                    <TextBlock Text="{Binding Resultat.CourantEmploi, StringFormat={}{0:0.0} A}" Style="{StaticResource IndicateurValeur}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="DISJONCTEUR GÉNÉRAL" Style="{StaticResource IndicateurLibelle}"/>
                    <TextBlock Text="{Binding Resultat.CalibreGeneral, StringFormat={}{0:0} A}" Style="{StaticResource IndicateurValeur}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="SECTION D'ARRIVÉE" Style="{StaticResource IndicateurLibelle}"/>
                    <TextBlock Text="{Binding Resultat.SectionArrivee, StringFormat={}{0:0.#} mm²}" Style="{StaticResource IndicateurValeur}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="DÉPARTS" Style="{StaticResource IndicateurLibelle}"/>
                    <TextBlock Text="{Binding Resultat.Departs.Count}" Style="{StaticResource IndicateurValeur}"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- Zone de travail : arbre, saisie, note de calcul -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="5*" MinWidth="380"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CadrePanneau}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button Style="{StaticResource BoutonPetit}" Margin="0,0,4,4" Content="Projet et réseau" Command="{Binding AfficherProjet}"/>
                        <Button Style="{StaticResource BoutonPetit}" Margin="0,0,4,4" Content="Sécurité machine" Command="{Binding AfficherSecurite}"/>
                        <Button Style="{StaticResource BoutonPetit}" Margin="0,0,4,4" Content="Automate" Command="{Binding AfficherAutomate}"/>
                        <Button Style="{StaticResource BoutonPetit}" Margin="0,0,4,4" Content="Bilan de puissance" Command="{Binding AfficherBilanPuissance}"/>
                        <Button Style="{StaticResource BoutonPetit}" Margin="0,0,4,4" Content="Bilan 24 V" Command="{Binding AfficherBilan24V}"/>
                        <Button Style="{StaticResource BoutonPetit}" Margin="0,0,4,4" Content="Contrôles CEM / BT" Command="{Binding AfficherControles}"/>
                        <Button Style="{StaticResource BoutonPetit}" Margin="0,0,4,4" Content="Armoire" Command="{Binding AfficherArmoire}"/>
                        <Button Style="{StaticResource BoutonPetit}" Margin="0,0,4,4" Content="Thermique" Command="{Binding AfficherThermique}"/>
                        <Button Style="{StaticResource BoutonPetit}" Margin="0,0,4,4" Content="Sélectivité" Command="{Binding AfficherSelectivite}"/>
                        <Button Style="{StaticResource BoutonPetit}" Margin="0,0,4,4" Content="Références" Command="{Binding AfficherReferences}"/>
                    </WrapPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BoutonPetit}" Command="{Binding OuvrirOrganigramme}"
                                ToolTip="Organigramme complet en plein écran : arrivée, jeu de barres et une colonne par départ">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE740;" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Organigramme"/></StackPanel>
                        </Button>
                        <TextBlock Text="MATÉRIEL" Style="{StaticResource TitrePanneau}"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource TexteSecondaire}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Une carte par départ, de l'amont vers l'aval. Cliquez une carte pour l'éditer."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Groupes}" ItemTemplate="{StaticResource GroupeMateriel}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Column="2" Style="{StaticResource CadrePanneau}">
                <DockPanel>
                    <!-- La note de calcul s'ouvre à la demande pour laisser la place à la saisie. -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding NoteVisible}" Padding="10,4"
                                      ToolTip="Afficher ou masquer la note de calcul de l'élément édité">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE8EF;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Note de calcul"/>
                            </StackPanel>
                        </ToggleButton>
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Left"
                                 Fill="{Binding Note.StatutGlobal, Converter={StaticResource StatutCouleur}}"
                                 ToolTip="État de la note de calcul de l'élément édité"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding Selection}" Binding.SourceUpdated="ModificationSaisie"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                          Visibility="{Binding NoteVisible, Converter={StaticResource VraiVisible}}"/>

            <Border Grid.Column="4" Style="{StaticResource CadrePanneau}" Width="440"
                    Visibility="{Binding NoteVisible, Converter={StaticResource VraiVisible}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BoutonPetit}" Command="{Binding BasculerNote}" ToolTip="Fermer la note de calcul"
                                VerticalAlignment="Top">
                            <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE711;"/>
                        </Button>
                        <TextBlock Text="{Binding TitreNote}" Style="{StaticResource TitrePanneau}" TextWrapping="Wrap"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Note.Lignes}" ItemTemplate="{StaticResource LigneNote}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
