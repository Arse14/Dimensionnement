<Window x:Class="Dimensionnement.App.Vues.FenetreForcage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forcer une valeur" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Fond}" Foreground="{StaticResource Texte}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock x:Name="Libelle" Style="{StaticResource Section}" Margin="0,0,0,4" TextWrapping="Wrap"/>
        <TextBlock x:Name="Calcul" Foreground="{StaticResource TexteSecondaire}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <DockPanel Style="{StaticResource Ligne}">
            <TextBlock Text="Valeur imposée" Style="{StaticResource Etiquette}" Width="130"/>
            <TextBox x:Name="SaisieValeur"/>
        </DockPanel>
        <DockPanel Style="{StaticResource Ligne}">
            <TextBlock Text="Motif (obligatoire)" Style="{StaticResource Etiquette}" Width="130"/>
            <TextBox x:Name="SaisieMotif"/>
        </DockPanel>
        <TextBlock x:Name="Erreur" Foreground="#F85149" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Annuler" IsCancel="True"/>
            <Button Content="Forcer la valeur" Style="{StaticResource BoutonAccent}" IsDefault="True" Margin="0" Click="Valider"/>
        </StackPanel>
    </StackPanel>
</Window>
