<Window x:Class="Dimensionnement.App.Vues.FenetreApercuRapport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Aperçu du rapport" Width="1100" Height="900" MinWidth="700" MinHeight="500"
        Icon="/Ressources/icone.ico"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Fond}"
        Foreground="{StaticResource Texte}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Style="{StaticResource CadrePanneau}" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Ouvrir dans le navigateur" Click="OuvrirNavigateur" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BoutonAccent}" Click="GenererPdf" Margin="0">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icones}" Text="&#xE749;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Générer le PDF"/></StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TexteSecondaire}" TextWrapping="Wrap"
                           Text="Le rapport tel qu'il sera imprimé. Il suit les modifications du projet ; générez le PDF quand il vous convient."/>
            </DockPanel>
        </Border>
        <Grid>
            <wv2:WebView2 x:Name="Vue"/>
            <TextBlock x:Name="Erreur" Visibility="Collapsed" TextWrapping="Wrap" Margin="20"
                       Foreground="{StaticResource TexteSecondaire}"/>
        </Grid>
    </DockPanel>
</Window>
